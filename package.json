{
  "name": "arvo-core",
  "version": "3.0.28",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "description": "The core Arvo package which provides application tier core primitives and contract system for building production-grade event-driven application. Provides ArvoEvent (CloudEvents-compliant), ArvoContract for type-safe service interfaces, event factories, OpenTelemetry integration, and orchestration utilities - enabling infrastructure-agnostic, composable, and observable distributed systems-compliant applications.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaadAhmad123/arvo-core"
  },
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/index.js",
    "dev": "ts-node ./src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check --fix",
    "format": "biome format --fix",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "arvo",
    "event-driven",
    "cloudevents",
    "opentelemetry",
    "distributed-systems",
    "event-sourcing",
    "messaging",
    "microservices",
    "observability",
    "type-safe",
    "orchestration",
    "async",
    "workflow",
    "telemetry",
    "events"
  ],
  "author": "Saad Ahmad <saadkwi12@hotmail.com>",
  "homepage": "https://www.arvo.land",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@changesets/cli": "2.31.1",
    "@fission-ai/openspec": "^1.7.0",
    "@opentelemetry/api": "1.9.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "16.6.1",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "zod": "^4.0.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=22.0.0"
  }
}
