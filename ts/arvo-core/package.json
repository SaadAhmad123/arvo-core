{
  "name": "arvo-core",
  "version": "3.0.28",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./outbox/inmemory": {
      "types": "./dist/outbox/inmemory/index.d.ts",
      "import": "./dist/outbox/inmemory/index.js"
    },
    "./outbox/sqlite": {
      "types": "./dist/outbox/sqlite/index.d.ts",
      "import": "./dist/outbox/sqlite/index.js"
    },
    "./outbox/conformance": {
      "types": "./dist/outbox/conformance/index.d.ts",
      "import": "./dist/outbox/conformance/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "description": "The core Arvo package which provides application tier core primitives and contract system for building production-grade event-driven application. Provides ArvoEvent (CloudEvents-compliant), ArvoContract for type-safe service interfaces, event factories, OpenTelemetry integration, and orchestration utilities - enabling infrastructure-agnostic, composable, and observable distributed systems-compliant applications.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaadAhmad123/arvo-core"
  },
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/index.js",
    "dev": "ts-node ./src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint:fix": "biome check --fix",
    "format": "biome format --fix",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "arvo",
    "event-driven",
    "cloudevents",
    "opentelemetry",
    "distributed-systems",
    "event-sourcing",
    "messaging",
    "microservices",
    "observability",
    "type-safe",
    "orchestration",
    "async",
    "workflow",
    "telemetry",
    "events"
  ],
  "author": "Saad Ahmad <saadkwi12@hotmail.com>",
  "homepage": "https://www.arvo.land",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "3.0.3",
    "@fission-ai/openspec": "1.15.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "better-sqlite3": "13.0.3",
    "cloudevents": "10.0.0",
    "dotenv": "18.0.8",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "better-sqlite3": "^13.0.0",
    "cloudevents": "^10.0.0",
    "vitest": "^5.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "fast-uri": "4.2.3",
    "neverthrow": "8.2.0"
  }
}
